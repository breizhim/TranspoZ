{
  "name": "transpoz-desktop",
  "productName": "TranspoZ",
  "desktopName": "transpoz.desktop",
  "version": "0.3.0",
  "description": "TranspoZ – transposition et correction de partitions, application de bureau (sans serveur)",
  "author": "Breizhim <breizhim@protonmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "prepare-web": "node scripts/prepare-web.mjs",
    "fetch-audiveris": "node scripts/fetch-audiveris.mjs",
    "start": "electron .",
    "dist:linux": "node scripts/fetch-audiveris.mjs linux && node scripts/prepare-web.mjs && electron-builder --linux --publish never",
    "dist:win": "node scripts/fetch-audiveris.mjs win && node scripts/prepare-web.mjs && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.breizhim.transpoz",
    "productName": "TranspoZ",
    "artifactName": "TranspoZ-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "staging/web",
        "to": "web"
      },
      {
        "from": "THIRD_PARTY.md",
        "to": "THIRD_PARTY.md"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Audio",
      "icon": "resources/icon.png",
      "extraResources": [
        {
          "from": "vendor/audiveris-linux",
          "to": "audiveris"
        }
      ],
      "syncDesktopName": true,
      "maintainer": "Breizhim <breizhim@protonmail.com>",
      "synopsis": "Transposition et correction de partitions",
      "executableName": "transpoz"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png",
      "extraResources": [
        {
          "from": "vendor/audiveris-win",
          "to": "audiveris"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "TranspoZ"
    },
    "rpm": {
      "depends": [
        "libX11.so.6()(64bit)",
        "libXcomposite.so.1()(64bit)",
        "libXdamage.so.1()(64bit)",
        "libXext.so.6()(64bit)",
        "libXfixes.so.3()(64bit)",
        "libXi.so.6()(64bit)",
        "libXrandr.so.2()(64bit)",
        "libXrender.so.1()(64bit)",
        "libXtst.so.6()(64bit)",
        "libasound.so.2()(64bit)",
        "libatk-1.0.so.0()(64bit)",
        "libatk-bridge-2.0.so.0()(64bit)",
        "libatspi.so.0()(64bit)",
        "libcairo.so.2()(64bit)",
        "libcups.so.2()(64bit)",
        "libdbus-1.so.3()(64bit)",
        "libexpat.so.1()(64bit)",
        "libgbm.so.1()(64bit)",
        "libgio-2.0.so.0()(64bit)",
        "libglib-2.0.so.0()(64bit)",
        "libgobject-2.0.so.0()(64bit)",
        "libgtk-3.so.0()(64bit)",
        "libnspr4.so()(64bit)",
        "libnss3.so()(64bit)",
        "libnssutil3.so()(64bit)",
        "libpango-1.0.so.0()(64bit)",
        "libsmime3.so()(64bit)",
        "libudev.so.1()(64bit)",
        "libxcb.so.1()(64bit)",
        "libxkbcommon.so.0()(64bit)",
        "libz.so.1()(64bit)",
        "xdg-utils"
      ]
    }
  },
  "homepage": "https://github.com/breizhim/TranspoZ"
}
